{
  "name": "@neeyo/mantine-datatable",
  "version": "0.1.0",
  "description": "The lightweight, dark-theme aware table component for your Mantine UI data-rich applications, featuring asynchronous data loading support, pagination, intuitive Gmail-style additive batch rows selection, column sorting, custom cell data rendering, row expansion, nesting, and much more",
  "keywords": [
    "mantine",
    "data",
    "table",
    "grid",
    "datatable",
    "datagrid",
    "data table",
    "data grid",
    "virtualization",
    "async",
    "nested",
    "sorting",
    "pagination",
    "react",
    "component",
    "react server components",
    "typescript",
    "ui",
    "user interface",
    "ux",
    "user experience"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/documatrix/mantine-datatable.git"
  },
  "homepage": "https://documatrix.github.io/mantine-datatable/",
  "bugs": {
    "url": "https://github.com/documatrix/mantine-datatable/issues"
  },
  "license": "MIT",
  "files": [
    "./dist",
    "./README.md",
    "./LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css"
  },
  "scripts": {
    "dev": "next dev",
    "build:package": "rm -rf dist; tsdown; postcss package/styles*.css --dir dist",
    "build:docs": "next build",
    "build": "bun run build:package && bun run build:docs",
    "lint": "next typegen && biome check . && tsc --noEmit --pretty",
    "format": "biome format --write .",
    "check-updates": "bunx npm-check-updates --interactive --format group"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.5.15",
    "@faker-js/faker": "10.6.0",
    "@formkit/auto-animate": "0.10.0",
    "@hello-pangea/dnd": "18.0.1",
    "@mantine/code-highlight": "9.7.2",
    "@mantine/core": "^9.7.2",
    "@mantine/dates": "9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@mantine/modals": "9.7.2",
    "@mantine/notifications": "9.7.2",
    "@rolldown/plugin-babel": "0.2.4",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.104.2",
    "@types/babel__core": "7.20.5",
    "@types/lodash": "4.17.26",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "clsx": "2.1.1",
    "cssnano": "8.0.10",
    "dayjs": "1.11.23",
    "lodash": "4.18.1",
    "next": "16.4.0",
    "postcss": "8.5.29",
    "postcss-cli": "11.0.1",
    "postcss-import": "16.2.0",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "0.35.5",
    "shiki": "4.5.0",
    "swr": "2.5.1",
    "tsdown": "0.23.1",
    "typescript": "6.0.3"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ],
  "peerDependencies": {
    "@mantine/core": ">=9.0",
    "@mantine/hooks": ">=9.0",
    "clsx": ">=2",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.15"
  }
}
